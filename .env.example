# ── Bot Herbalis España ──────────────────────────────────────────────────────
# Fork del bot argentino adaptado a España: español peninsular, envíos por
# Correos y TODO contra reembolso (no hay ninguna pasarela de pago).
#
# ⚠️ Este proyecto necesita su PROPIA base de datos y su PROPIO Redis. Si
# comparte DATABASE_URL con el bot argentino, los pedidos y las conversaciones
# de los dos negocios acaban en las mismas tablas.

OPENAI_API_KEY=sk-proj-xxxxxxxxxxxxxxxxxxxx
API_KEY=seguridad-dashboard-123
PORT=3000

# Base de datos y Redis — propios de este bot, NO los del bot argentino.
DATABASE_URL=postgresql://user:pass@host:5432/herbalis_es
REDIS_URL=redis://127.0.0.1:6379

# Claude como motor del chat() (Sonnet en pasos premium, Haiku en el resto) en vez
# de GPT-4o. Si CLAUDE_AB_SELLERS está vacío o falta ANTHROPIC_API_KEY, queda OFF
# (todo en OpenAI). CLAUDE_AB_SELLERS: lista de sellers (coma-separados) o '*' para
# TODOS (migración full, incluye sellers futuros). CLAUDE_AB_PERCENT = % de las
# conversaciones que van a Claude (split determinista por teléfono; 100 = todas).
# Whisper, embeddings y visión siguen SIEMPRE en OpenAI (Anthropic no los tiene).
# ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxx
# CLAUDE_AB_SELLERS=*
# CLAUDE_AB_PERCENT=100
# CLAUDE_MODEL_PREMIUM=claude-sonnet-4-6
# CLAUDE_MODEL_SIMPLE=claude-haiku-4-5-20251001

# Tope mensual de gasto de IA (USD). El scheduler acumula el coste del mes en
# DATA_DIR/ai-cost-<YYYY-MM>.json y avisa al admin al 80% y al 100% del tope.
# 0 = desactivar el guardián. Default 500.
# AI_MONTHLY_BUDGET_USD=500

# Validación de direcciones con Google Maps (opcional). Sin esta clave el bot
# valida solo el formato del código postal; con ella comprueba además que la
# dirección exista y esté en España.
# GOOGLE_MAPS_KEY=AIza...

# JWT Auth (multi-tenant)
JWT_SECRET=your_jwt_secret_64chars_min
SEED_ADMIN_EMAIL=admin@tudominio.com
SEED_ADMIN_PASSWORD=your_admin_password_here

# Railway / Producción
# DATA_DIR=/data
# VITE_API_KEY=your-api-key-here

# ElevenLabs TTS
# ELEVENLABS_API_KEY=your_elevenlabs_api_key
# ELEVENLABS_VOICE_ID=EXAVITQu4vr4xnSDxMaL
